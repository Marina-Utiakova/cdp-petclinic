pipeline {
  agent any
  tools {
    maven 'MAVEN3'
  }
  environment {
    NEXUS_URL             = 'http://100.26.97.74:8081'
    NEXUS_DOWNLOAD_CRED   = 'nexus-user-pass'
    NEXUS_UPLOAD_CRED     = 'nexus-ci-creds'
    REPO_RELEASE          = 'vprofile-release'
    GROUP_ID              = 'org.springframework.samples'
    ARTIFACT_ID           = 'spring-petclinic'
    VERSION               = "${env.BUILD_NUMBER}"
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build WAR') {
      steps {
        // генерируем settings.xml внутри сборки
        withCredentials([usernamePassword(
          credentialsId: env.NEXUS_DOWNLOAD_CRED,
          usernameVariable: 'NEXUS_USR',
          passwordVariable: 'NEXUS_PSW'
        )]) {
          sh '''
            cat > settings.xml <<EOF
<settings>
  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <name>Nexus Public Mirror</name>
      <url>${NEXUS_URL}/repository/maven-public/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>nexus-public</id>
      <username>${NEXUS_USR}</username>
      <password>${NEXUS_PSW}</password>
    </server>
  </servers>
</settings>
EOF
            mvn -s settings.xml clean package -DskipTests -Dcheckstyle.skip=true
          '''
        }
      }
    }

    stage('Publish to Nexus') {
      steps {
        // загружаем артефакт в Nexus
        nexusArtifactUploader(
          nexusVersion: 'nexus3',
          protocol:    'http',
          nexusUrl:    env.NEXUS_URL,
          repository:  env.REPO_RELEASE,
          credentialsId: env.NEXUS_UPLOAD_CRED,
          groupId:     env.GROUP_ID,
          version:     env.VERSION,
          artifacts: [[
            artifactId: env.ARTIFACT_ID,
            file:       "target/${env.ARTIFACT_ID}-${env.VERSION}.war",
            type:       'war'
          ]]
        )
      }
    }
  }

  post {
    success {
      echo "✅ Published ${GROUP_ID}:${ARTIFACT_ID}:${VERSION} to Nexus"
    }
    failure {
      echo "❌ Build or publish failed"
    }
  }
}



