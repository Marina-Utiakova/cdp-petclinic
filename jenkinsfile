pipeline {
  agent any
  tools { maven 'MAVEN3' }

  environment {
    NEXUS_HOSTPORT      = '100.26.97.74:8081'
    NEXUS_DOWNLOAD_CRED = 'nexus-user-pass'
    NEXUS_UPLOAD_CRED   = 'nexus-ci-creds'
    REPO_RELEASE        = 'vprofile-release'
    REPO_SNAPSHOT       = 'vprofile-snapshot'
    GROUP_ID            = 'org.springframework.samples'
    ARTIFACT_ID         = 'spring-petclinic'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build & Deploy') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: env.NEXUS_CRED,
          usernameVariable: 'NEXUS_USR',
          passwordVariable: 'NEXUS_PSW'
        )]) {
          sh '''
            # Генерируем settings.xml с mirror и server-ами
            cat > settings.xml <<EOF
<settings>
  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <name>Nexus Public Mirror</name>
      <url>http://${NEXUS_HOSTPORT}/repository/maven-public/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>vprofile-release</id>
      <username>${NEXUS_USR}</username>
      <password>${NEXUS_PSW}</password>
    </server>
    <server>
      <id>vprofile-snapshot</id>
      <username>${NEXUS_USR}</username>
      <password>${NEXUS_PSW}</password>
    </server>
  </servers>
</settings>
EOF

            # Собираем и сразу деплоим в правильный репозиторий
            mvn -s settings.xml clean deploy -DskipTests -Dcheckstyle.skip=true
          '''
        }
      }
    }
  }

  post {
    success {
      echo "✅ Build & deploy to Nexus succeeded"
    }
    failure {
      echo "❌ Build or deploy failed"
    }
  }
}




